generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Keluarga {
  idKeluarga         String              @id @default(uuid()) @map("id_keluarga")
  namaAyah           String?             @map("nama_ayah")
  namaIbu            String?             @map("nama_ibu")
  noHp               String              @map("no_hp")
  email              String?             @unique
  alamat             String?             @db.Text
  fileKK             String?             @map("file_kk")
  fileKTP            String?             @map("file_ktp")
  anak               Anak[]
  berkasKeluarga     BerkasKeluarga[]
  bookingKunjungan   BookingKunjungan[]

  @@map("keluarga")
}

model BerkasKeluarga {
  idBerkasKel      String               @id @default(uuid()) @map("id_berkas_kel")
  idKeluarga       String               @map("id_keluarga")
  jenis            JenisBerkasKeluarga
  file             String               @db.Text
  statusVerifikasi StatusVerifikasi     @default(MENUNGGU) @map("status_verifikasi")
  keluarga         Keluarga             @relation(fields: [idKeluarga], references: [idKeluarga], onDelete: Cascade)

  @@index([idKeluarga])
  @@map("berkas_keluarga")
}

model SlotJadwal {
  idSlot           String               @id @default(uuid()) @map("id_slot")
  tanggal          DateTime             @db.Date
  jam              DateTime             @db.Time(0)
  kuota            Int
  bookingKunjungan BookingKunjungan[]

  @@map("slot_jadwal")
}

model BookingKunjungan {
  idBooking  String        @id @default(uuid()) @map("id_booking")
  idKeluarga String        @map("id_keluarga")
  idSlot     String        @map("id_slot")
  status     StatusBooking @default(MENUNGGU)
  keluarga   Keluarga      @relation(fields: [idKeluarga], references: [idKeluarga], onDelete: Cascade)
  slot       SlotJadwal    @relation(fields: [idSlot], references: [idSlot], onDelete: Cascade)

  @@index([idKeluarga])
  @@index([idSlot])
  @@map("booking_kunjungan")
}

model Kelompok {
  idKelompok      String            @id @default(uuid()) @map("id_kelompok")
  nama            String
  usiaMin         Int               @map("usia_min")
  usiaMaks        Int               @map("usia_maks")
  riwayatKelompok RiwayatKelompok[]

  @@map("kelompok")
}

model Anak {
  idAnak           String               @id @default(uuid()) @map("id_anak")
  idKeluarga       String               @map("id_keluarga")
  nama             String
  nik              String               @unique
  tglLahir         DateTime             @map("tgl_lahir") @db.Date
  status           StatusAnak           @default(PENDAFTAR)
  keluarga         Keluarga             @relation(fields: [idKeluarga], references: [idKeluarga], onDelete: Cascade)
  berkasAnak       BerkasAnak[]
  laporanMingguan  LaporanMingguan[]
  rekeningTabungan RekeningTabungan?
  riwayatKelompok  RiwayatKelompok[]
  tagihan          Tagihan[]

  @@index([idKeluarga])
  @@map("anak")
}

model BerkasAnak {
  idBerkasAnak     String               @id @default(uuid()) @map("id_berkas_anak")
  idAnak           String               @map("id_anak")
  jenis            JenisBerkasAnak
  file             String               @db.Text
  statusVerifikasi StatusVerifikasi     @default(MENUNGGU) @map("status_verifikasi")
  anak             Anak                 @relation(fields: [idAnak], references: [idAnak], onDelete: Cascade)

  @@index([idAnak])
  @@map("berkas_anak")
}

model TahunAjaran {
  idTahunAjaran   String            @id @default(uuid()) @map("id_tahun_ajaran")
  periode         String
  statusAktif     Boolean           @default(false) @map("status_aktif")
  riwayatKelompok RiwayatKelompok[]

  @@map("tahun_ajaran")
}

model RiwayatKelompok {
  idRiwayat     String      @id @default(uuid()) @map("id_riwayat")
  idAnak        String      @map("id_anak")
  idKelompok    String      @map("id_kelompok")
  idTahunAjaran String      @map("id_tahun_ajaran")
  anak          Anak        @relation(fields: [idAnak], references: [idAnak], onDelete: Cascade)
  kelompok      Kelompok    @relation(fields: [idKelompok], references: [idKelompok], onDelete: Cascade)
  tahunAjaran   TahunAjaran @relation(fields: [idTahunAjaran], references: [idTahunAjaran], onDelete: Cascade)

  @@index([idAnak])
  @@index([idKelompok])
  @@index([idTahunAjaran])
  @@map("riwayat_kelompok")
}

model Tagihan {
  idTagihan  String        @id @default(uuid()) @map("id_tagihan")
  idAnak     String        @map("id_anak")
  jenis      JenisTagihan
  bulan      Int?
  nominal    Decimal       @db.Decimal(12, 2)
  diskon     Decimal       @default(0.00) @db.Decimal(12, 2)
  status     StatusTagihan @default(BELUM_BAYAR)
  pembayaran Pembayaran[]
  anak       Anak          @relation(fields: [idAnak], references: [idAnak], onDelete: Cascade)

  @@index([idAnak])
  @@map("tagihan")
}

model RekeningTabungan {
  idTabungan String              @id @default(uuid()) @map("id_tabungan")
  idAnak     String              @unique @map("id_anak")
  saldo      Decimal             @default(0.00) @db.Decimal(12, 2)
  anak       Anak                @relation(fields: [idAnak], references: [idAnak], onDelete: Cascade)
  transaksi  TransaksiTabungan[]

  @@map("rekening_tabungan")
}

model TransaksiTabungan {
  idTransaksi String                 @id @default(uuid()) @map("id_transaksi")
  idTabungan  String                 @map("id_tabungan")
  idTagihan   String?                @map("id_tagihan")
  jenis       JenisTransaksiTabungan
  metode      MetodePembayaran       @default(TUNAI)
  nominal     Decimal                @db.Decimal(12, 2)
  keterangan  String?                @db.Text
  bukti       String?                @db.Text
  status      StatusVerifikasi       @default(MENUNGGU)
  dicatatOleh String?                @map("dicatat_oleh")
  createdAt   DateTime               @default(now()) @map("created_at")
  tabungan    RekeningTabungan       @relation(fields: [idTabungan], references: [idTabungan], onDelete: Cascade)

  @@index([idTabungan])
  @@index([status, createdAt])
  @@map("transaksi_tabungan")
}

model Pembayaran {
  idPembayaran     String           @id @default(uuid()) @map("id_pembayaran")
  idTagihan        String           @map("id_tagihan")
  metode           MetodePembayaran
  buktiTransfer    String?          @map("bukti_transfer") @db.Text
  diverifikasiOleh String?          @map("diverifikasi_oleh")
  tagihan          Tagihan          @relation(fields: [idTagihan], references: [idTagihan], onDelete: Cascade)

  @@index([idTagihan])
  @@map("pembayaran")
}

model TemaPembelajaran {
  idTema          String            @id @default(uuid()) @map("id_tema")
  namaTema        String            @map("nama_tema")
  mingguKe        Int               @map("minggu_ke")
  laporanMingguan LaporanMingguan[]

  @@map("tema_pembelajaran")
}

model LaporanMingguan {
  idLaporan       String           @id @default(uuid()) @map("id_laporan")
  idAnak          String           @map("id_anak")
  idTema          String           @map("id_tema")
  aspek           String
  catatanKegiatan String           @map("catatan_kegiatan") @db.Text
  anak            Anak             @relation(fields: [idAnak], references: [idAnak], onDelete: Cascade)
  tema            TemaPembelajaran @relation(fields: [idTema], references: [idTema], onDelete: Cascade)

  @@index([idAnak])
  @@index([idTema])
  @@map("laporan_mingguan")
}

enum JenisBerkasKeluarga {
  KK
  KTP_ORTU
}

enum JenisBerkasAnak {
  AKTA
  KIA
  PAS_FOTO
}

enum StatusVerifikasi {
  MENUNGGU
  DIVERIFIKASI
  DITOLAK
}

enum StatusBooking {
  MENUNGGU
  DIKONFIRMASI
  DIBATALKAN
  SELESAI
}

enum StatusAnak {
  PENDAFTAR
  AKTIF
}

enum JenisTagihan {
  SPP
  PENDAFTARAN
}

enum StatusTagihan {
  BELUM_BAYAR
  MENUNGGU_VERIFIKASI
  LUNAS
  DIBATALKAN
}

enum MetodePembayaran {
  TRANSFER
  TUNAI
  TABUNGAN
}

enum JenisTransaksiTabungan {
  SETOR
  TARIK
  BAYAR_SPP
}